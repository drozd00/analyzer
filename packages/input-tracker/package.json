{
  "name": "input-tracker",
  "version": "1.0.0",
  "description": "InputTracker: privacy-safe client-side TypeScript tracking for raw form interaction events.",
  "keywords": [
    "browser",
    "forms",
    "privacy",
    "telemetry",
    "tracking",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf ./dist",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "npm run build && node --test ./test/*.test.mjs",
    "prepublishOnly": "npm run check && npm run test"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
