{
  "extends": "nitro/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@server/*": ["./server/*"],
      "@datastore/*": ["./*"]
    }
  },
  "include": ["server/**/*.ts", "test/**/*.ts", "nitro.config.ts"]
}
